generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String        @id @default(uuid())
  username           String        @unique
  passwordHash       String
  accepted           Boolean       @default(false)
  pfpId              String?
  admin              Boolean       @default(false)
  dateOfRegistration DateTime      @default(now())
  images             Image[]       @relation("UserUploadedImages")
  tokens             Token[]
  transactions       Transaction[]
  image              Image?        @relation("UserProfilePicture", fields: [pfpId], references: [id])
}

model Token {
  id          String   @id @default(uuid())
  userId      String
  userAgent   String
  dateOfLogin DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Pool {
  id             String        @id @default(uuid())
  name           String        @unique
  dateOfCreation DateTime      @default(now())
  transactions   Transaction[]
}

model Setting {
  key  String @id
  data String
}

model Image {
  id             String   @id @default(uuid())
  userId         String
  storedFilename String
  dateOfUpload   DateTime @default(now())
  user           User     @relation("UserUploadedImages", fields: [userId], references: [id])
  users          User[]   @relation("UserProfilePicture")
}

model Transaction {
  id                String          @id @default(uuid())
  userId            String
  poolId            String
  type              String
  moneyAmount       Int
  coffeeAmount      Int
  coffeeVariationId String
  dateOfTransaction DateTime        @default(now())
  coffeevariation   CoffeeVariation @relation(fields: [coffeeVariationId], references: [id])
  pool              Pool            @relation(fields: [poolId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
}

model CoffeeVariation {
  id           String        @id
  coffeeAmount Int
  transactions Transaction[]
}
