    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prisma": "^7.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
