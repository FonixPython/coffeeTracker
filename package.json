{
  "name": "web-radio",
  "version": "1.0.0",
  "description": "A simple web radio with an admin interface, that streams music 24/7 written for Node",
  "main": "index.js",
  "scripts": {
    "build:frontend": "cd client && vite build",
    "build:backend": "cd backend && tsc",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/index",
    "dev": "cd client && vite dev",
    "f": "npm run build && npm run start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FonixPython/Web-Radio.git"
  },
  "keywords": [],
